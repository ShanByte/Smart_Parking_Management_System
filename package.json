{
  "name": "smart-parking-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "simulator"
  ],
  "scripts": {
    "build": "npm run build -w shared --if-present && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && eslint .",
    "typecheck": "npm run typecheck -w shared --if-present && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
