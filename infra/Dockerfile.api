# ==============================================================================
# Dockerfile.api - Multi-stage build for API service
# ==============================================================================

# Stage 1: Build stage
FROM node:25.2.1-alpine3.21 AS builder

WORKDIR /app

# Copy root configuration and package manifests
COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/

# Install dependencies
RUN npm ci

# Copy source directories
COPY shared/ ./shared/
COPY backend/ ./backend/

# Build shared first, then backend
RUN npm run build -w shared && npm run build -w backend

# Prune devDependencies for production runtime
RUN npm prune --production

# Stage 2: Runtime stage
FROM node:25.2.1-alpine3.21 AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy application files with unprivileged ownership
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/package.json ./package.json
COPY --chown=node:node --from=builder /app/shared/package.json ./shared/package.json
COPY --chown=node:node --from=builder /app/shared/dist ./shared/dist
COPY --chown=node:node --from=builder /app/backend/package.json ./backend/package.json
COPY --chown=node:node --from=builder /app/backend/dist ./backend/dist
COPY --chown=node:node --from=builder /app/backend/prisma ./backend/prisma

# Run as non-root user
USER node

# Healthcheck targeting Contract C4 /health route
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 4000) + '/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

EXPOSE 4000

CMD ["npm", "run", "start", "-w", "backend"]
